# Bot Wars - Environment Variables
# Copy this file to .env and fill in your API keys.

# OpenAI API key (required for GPT-4 experiments and dialogue analysis)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API key (required for DeepSeek experiments)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OctoAI API key (required for Mixtral experiments)
OCTOAI_API_KEY=your_octoai_api_key_here
